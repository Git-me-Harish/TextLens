DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/textlens
REDIS_URL=redis://localhost:6380/0
MINIO_ENDPOINT=http://localhost:9100
MINIO_PUBLIC_URL=http://localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=textlens

SECRET_KEY=your_secret_key_here
ANTHROPIC_API_KEY=
GROQ_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication settings for Google OAuth:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:5173

RESEND_API_KEY=
FROM_EMAIL=TextLens <notify@yourdomain.com>

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=30

# Application settings:
ENVIRONMENT=development

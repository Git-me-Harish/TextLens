
# TextLens Agentic Document Intelligence Platform

# Database 
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/textlens
# For Alembic (sync driver):
SYNC_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/textlens

#  Redis 
REDIS_URL=redis://localhost:6379/0

# Application 
SECRET_KEY=your-256-bit-secret-key-here-generate-with-secrets.token_hex-32
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Anthropic 
ANTHROPIC_API_KEY=sk-ant-...

# Storage (MinIO / S3) 
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=textlens
MINIO_SECURE=false


# AGENTIC ACTION LAYER
# Claude model used by all domain agents
AGENT_MODEL=claude-sonnet-4-20250514

# AES-256-GCM key for encrypting MCP credentials at rest
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_ENCRYPTION_KEY=your_64_character_hex_key_here_generate_fresh_never_reuse

# Current encryption key version (increment when rotating)
MCP_KEY_VERSION=1

# Per-version keys (for rotation — add V2 when rotating from V1)
MCP_ENCRYPTION_KEY_V1=same_as_MCP_ENCRYPTION_KEY_above
# MCP_ENCRYPTION_KEY_V2=new_key_when_rotating

# HITL approval token TTL in minutes (default 15)
APPROVAL_TOKEN_TTL_MINUTES=15

# Celery queue for action tasks
ACTION_CELERY_QUEUE=actions

# Sent as X-Internal-MCP-Secret on every outbound call to a self-hosted MCP
# proxy (google_calendar, email). Required to protect mcp_email.py from being
# an open relay for this app's Resend account once deployed beyond localhost.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_MCP_SHARED_SECRET=

# MCP SERVER URLs
# Replace with your actual deployed MCP server endpoints

# Google Calendar MCP server — implemented locally (app/api/routes/mcp_google_calendar.py),
# mounted on this same backend at /mcp/google-calendar. No separate deployment needed;
# just point this at wherever this backend itself is reachable.
# In docker-compose, use the backend service's internal address instead of localhost.
GOOGLE_CALENDAR_MCP_URL=http://localhost:8000/mcp/google-calendar

# Pharmacy MCP server — implemented locally (app/api/routes/mcp_pharmacy.py),
# backed by this app's own database (no real pharmacy partner account).
# Mounted on this same backend at /mcp/pharmacy.
PHARMACY_MCP_URL=http://localhost:8000/mcp/pharmacy

# Job Board MCP server — implemented locally (app/api/routes/mcp_job_board.py),
# backed by this app's own database (no real job-board partner account).
# Mounted on this same backend at /mcp/job-board.
JOB_BOARD_MCP_URL=http://localhost:8000/mcp/job-board

# Accounting MCP server — implemented locally (app/api/routes/mcp_accounting.py),
# backed by this app's own database (no real QuickBooks/Xero/Zoho account).
# Mounted on this same backend at /mcp/accounting.
ACCOUNTING_MCP_URL=http://localhost:8000/mcp/accounting

# Email MCP server — implemented locally (app/api/routes/mcp_email.py), sends
# through this app's own RESEND_API_KEY (see the AI API keys block above).
# No per-user connection needed; mounted on this same backend at /mcp/email.
EMAIL_MCP_URL=http://localhost:8000/mcp/email


# TEST DATABASE (for pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/textlens_test
